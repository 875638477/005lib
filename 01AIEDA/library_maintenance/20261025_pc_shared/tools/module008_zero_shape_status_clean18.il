; Exact actual-source CLASS repair only on owned independent8482candidate copy.
procedure(pub14CheckClassRows(rows restored)
 let((d byref c row expected)
  d=axlDBGetDesign() axlDBRefreshId(d) unless(length(d->components)==1643 error("Full1643 component count changed\n"))
  byref=makeTable('pub14ClassesByRef nil)
  foreach(c d->components axlDBRefreshId(c) axlDBRefreshId(c->compdef) when(byref[c->name] error("Duplicate actual component ref\n")) byref[c->name]=c)
  foreach(row rows
   c=byref[car(row)] unless(c error("Exact original ref missing\n"))
   expected=if(restored then nth(4 row) else nth(3 row))
   unless(equal(c->deviceType nth(1 row)) && equal(c->compdef->deviceType nth(1 row)) && equal(c->package nth(2 row)) && equal(c->class expected) && equal(c->compdef->class expected) printf("BAD_REF=%L EXPECTED_ROW=%L ACTUAL_DT=%L ACTUAL_COMPDEF_DT=%L ACTUAL_PACKAGE=%L ACTUAL_COMPONENT_CLASS=%L ACTUAL_COMPDEF_CLASS=%L RESTORED_MODE=%L\n" car(row) row c->deviceType c->compdef->deviceType c->package c->class c->compdef->class restored) error("Exact ref/device/package/CLASS precondition failed\n"))) t))
