procedure(hi2LProfile(out board lib)
 let((f oldRegion oldTables nc old net pair)
  f=outfile(strcat(out "/hi_2L_profile_execution.txt"))
  hiRegistry=nil
  unless(equal(axlSubclassRoute() list("TOP" "BOTTOM")) error("2L profile on wrong board\n"))
  oldRegion=car(setof(r axlDBGetDesign()->region equal(r->name "G31_U1_ESCAPE")))
  unless(oldRegion error("Original G31 region missing\n"))
  oldTables=axlCnsClassTableFind('match oldRegion)
  fprintf(f "OLD_G31_TABLES_REMOVED=%L\n" oldTables)
  when(oldTables unless(axlCnsClassTableDelete(oldTables) error("Cannot remove old G31 region associations\n")))
  unless(axlCNSCreate('physical "HI2L_P_POWER_INPUT" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" nil 'width_min "0.6 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" nil 'neckwidth_min "0.25 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" nil 'necklength_max "1.0 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" nil 'vias "L28_VIA030_C060") "Approved2L via")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" "TOP" 'allow_etch t) "2L layer permission")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_INPUT" "BOTTOM" 'allow_etch t) "2L layer permission")
  unless(axlCNSCreate('spacing "HI2L_S_POWER_INPUT" nil) error("Cannot create2L spacing CSet\n"))
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'smdpin_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'line_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'via_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'line_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'via_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_INPUT" nil 'shape_shape "0.3 MM") "2L explicit spacing value")
  nc=axlNetClassCreate("HI2L_POWER_INPUT_P" 'physical)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_POWER_INPUT")))
  net=axlDBFindByName('net "VIN_RAW")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_RAW" 'physical old->name "HI2L_POWER_INPUT_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_FUSED")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_FUSED" 'physical old->name "HI2L_POWER_INPUT_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_PROT")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_PROT" 'physical old->name "HI2L_POWER_INPUT_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_POWER_INPUT_S" 'spacing)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("SPACING_CONSTRAINT_SET" "HI2L_S_POWER_INPUT")))
  net=axlDBFindByName('net "VIN_RAW")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_RAW" 'spacing old->name "HI2L_POWER_INPUT_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_FUSED")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_FUSED" 'spacing old->name "HI2L_POWER_INPUT_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_PROT")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_PROT" 'spacing old->name "HI2L_POWER_INPUT_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_POWER_INPUT_E" 'electrical)
  unless(nc error("2L netclass create failed\n"))
  net=axlDBFindByName('net "VIN_RAW")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_RAW" 'electrical old->name "HI2L_POWER_INPUT_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_FUSED")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_FUSED" 'electrical old->name "HI2L_POWER_INPUT_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "VIN_PROT")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VIN_PROT" 'electrical old->name "HI2L_POWER_INPUT_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  unless(axlCNSCreate('physical "HI2L_P_POWER_LV" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" nil 'width_min "0.6 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" nil 'neckwidth_min "0.25 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" nil 'necklength_max "1.0 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" nil 'vias "L28_VIA030_C060") "Approved2L via")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" "TOP" 'allow_etch t) "2L layer permission")
  f29Must(axlCNSSetPhysical("HI2L_P_POWER_LV" "BOTTOM" 'allow_etch t) "2L layer permission")
  unless(axlCNSCreate('spacing "HI2L_S_POWER_LV" nil) error("Cannot create2L spacing CSet\n"))
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'smdpin_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'line_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'via_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'line_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'via_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_POWER_LV" nil 'shape_shape "0.3 MM") "2L explicit spacing value")
  nc=axlNetClassCreate("HI2L_POWER_LV_P" 'physical)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_POWER_LV")))
  net=axlDBFindByName('net "V5")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V5" 'physical old->name "HI2L_POWER_LV_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "V3V3")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V3V3" 'physical old->name "HI2L_POWER_LV_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_POWER_LV_S" 'spacing)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("SPACING_CONSTRAINT_SET" "HI2L_S_POWER_LV")))
  net=axlDBFindByName('net "V5")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V5" 'spacing old->name "HI2L_POWER_LV_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "V3V3")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V3V3" 'spacing old->name "HI2L_POWER_LV_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_POWER_LV_E" 'electrical)
  unless(nc error("2L netclass create failed\n"))
  net=axlDBFindByName('net "V5")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V5" 'electrical old->name "HI2L_POWER_LV_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "V3V3")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "V3V3" 'electrical old->name "HI2L_POWER_LV_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "V3V3")
  axlDBAddProp(list(net) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_POWER_LV") list("SPACING_CONSTRAINT_SET" "HI2L_S_POWER_LV")))
  unless(axlCNSCreate('physical "HI2L_P_VDDA" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" nil 'width_min "0.3 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" nil 'neckwidth_min "0.2 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" nil 'necklength_max "1.0 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" nil 'vias "L28_VIA030_C060") "Approved2L via")
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" "TOP" 'allow_etch t) "2L layer permission")
  f29Must(axlCNSSetPhysical("HI2L_P_VDDA" "BOTTOM" 'allow_etch t) "2L layer permission")
  unless(axlCNSCreate('spacing "HI2L_S_VDDA" nil) error("Cannot create2L spacing CSet\n"))
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'smdpin_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'line_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'via_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'line_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'via_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_VDDA" nil 'shape_shape "0.3 MM") "2L explicit spacing value")
  nc=axlNetClassCreate("HI2L_VDDA_P" 'physical)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_VDDA")))
  net=axlDBFindByName('net "VDDA")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VDDA" 'physical old->name "HI2L_VDDA_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_VDDA_S" 'spacing)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("SPACING_CONSTRAINT_SET" "HI2L_S_VDDA")))
  net=axlDBFindByName('net "VDDA")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VDDA" 'spacing old->name "HI2L_VDDA_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_VDDA_E" 'electrical)
  unless(nc error("2L netclass create failed\n"))
  net=axlDBFindByName('net "VDDA")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "VDDA" 'electrical old->name "HI2L_VDDA_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  unless(axlCNSCreate('physical "HI2L_P_GROUND" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" nil 'width_min "0.6 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" nil 'neckwidth_min "0.25 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" nil 'necklength_max "1.0 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" nil 'vias "L28_VIA030_C060") "Approved2L via")
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" "TOP" 'allow_etch t) "2L layer permission")
  f29Must(axlCNSSetPhysical("HI2L_P_GROUND" "BOTTOM" 'allow_etch t) "2L layer permission")
  unless(axlCNSCreate('spacing "HI2L_S_GROUND" nil) error("Cannot create2L spacing CSet\n"))
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'smdpin_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'line_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'via_line "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'line_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'via_shape "0.3 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_GROUND" nil 'shape_shape "0.3 MM") "2L explicit spacing value")
  nc=axlNetClassCreate("HI2L_GROUND_P" 'physical)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_GROUND")))
  net=axlDBFindByName('net "GND")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "GND" 'physical old->name "HI2L_GROUND_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_GROUND_S" 'spacing)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("SPACING_CONSTRAINT_SET" "HI2L_S_GROUND")))
  net=axlDBFindByName('net "GND")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "GND" 'spacing old->name "HI2L_GROUND_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_GROUND_E" 'electrical)
  unless(nc error("2L netclass create failed\n"))
  net=axlDBFindByName('net "GND")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "GND" 'electrical old->name "HI2L_GROUND_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "GND")
  axlDBAddProp(list(net) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_GROUND") list("SPACING_CONSTRAINT_SET" "HI2L_S_GROUND")))
  unless(axlCNSCreate('physical "HI2L_P_SWITCH" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" nil 'width_min "0.6 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" nil 'neckwidth_min "0.25 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" nil 'necklength_max "1.0 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" nil 'vias "L28_VIA030_C060") "Approved2L via")
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" "TOP" 'allow_etch t) "2L layer permission")
  f29Must(axlCNSSetPhysical("HI2L_P_SWITCH" "BOTTOM" 'allow_etch nil) "2L layer permission")
  unless(axlCNSCreate('spacing "HI2L_S_SWITCH" nil) error("Cannot create2L spacing CSet\n"))
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'smdpin_line "0.5 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'line_line "0.5 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'via_line "0.5 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'line_shape "0.5 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'via_shape "0.5 MM") "2L explicit spacing value")
  f29Must(axlCNSSetSpacing("HI2L_S_SWITCH" nil 'shape_shape "0.5 MM") "2L explicit spacing value")
  nc=axlNetClassCreate("HI2L_SWITCH_P" 'physical)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("PHYSICAL_CONSTRAINT_SET" "HI2L_P_SWITCH")))
  net=axlDBFindByName('net "BUCK_SW")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_SW" 'physical old->name "HI2L_SWITCH_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "BUCK_BOOT")
  old=axlNetClassGet(net 'physical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_BOOT" 'physical old->name "HI2L_SWITCH_P") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_SWITCH_S" 'spacing)
  unless(nc error("2L netclass create failed\n"))
  axlDBAddProp(list(nc) list(list("SPACING_CONSTRAINT_SET" "HI2L_S_SWITCH")))
  net=axlDBFindByName('net "BUCK_SW")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_SW" 'spacing old->name "HI2L_SWITCH_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "BUCK_BOOT")
  old=axlNetClassGet(net 'spacing t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_BOOT" 'spacing old->name "HI2L_SWITCH_S") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  nc=axlNetClassCreate("HI2L_SWITCH_E" 'electrical)
  unless(nc error("2L netclass create failed\n"))
  net=axlDBFindByName('net "BUCK_SW")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_SW" 'electrical old->name "HI2L_SWITCH_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  net=axlDBFindByName('net "BUCK_BOOT")
  old=axlNetClassGet(net 'electrical t)
  when(old fprintf(f "CLASS_REASSIGN net=%L domain=%L old=%L new=%L\n" "BUCK_BOOT" 'electrical old->name "HI2L_SWITCH_E") unless(axlNetClassRemove(old net) error("Cannot remove prior class membership\n")))
  unless(axlNetClassAdd(nc net) error("Cannot bind2L netclass member\n"))
  unless(axlCNSCreate('physical "HI2L_P_FEEDBACK" nil) error("Cannot create2L physical CSet\n"))
  f29Must(axlCNSSetPhysical("HI2L_P_FEEDBACK" nil 'width_min "0.2 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_FEEDBACK" nil 'neckwidth_min "0.16 MM") "2L specific physical value")
  f29Must(axlCNSSetPhysical("HI2L_P_FEEDBACK" nil 'necklength_max "1.0 MM") "2L specific physical value")
