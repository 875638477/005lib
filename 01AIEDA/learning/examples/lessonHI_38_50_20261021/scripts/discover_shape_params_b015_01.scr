set NOCONFIRM
skill let((f names p) f=outfile("D:/001DIY/005lib/01AIEDA/learning/examples/lessonHI_38_50_20261021/logs/discover_shape_params_b015_01/shape_parameters.txt") names=axlGetParam(nil) fprintf(f "SUPPORTED_PARAMETER_NAMES=%L\nDESIGN_PROPERTIES=%L\nDYNAMIC_FILL_MODE=%L\n" names axlDBGetProperties(axlDBGetDesign()) axlDBControl('dynamicFillMode)) foreach(n names when(rexMatchp("[Ss][Hh][Aa][Pp][Ee]\\|[Tt][Hh][Ee][Rr][Mm][Aa][Ll]\\|[Vv][Oo][Ii][Dd]" n) p=axlGetParam(n) fprintf(f "SHAPE_PARAMETER name=%L attributes=%L\n" n if(p then p->?? else nil)))) close(f))
quit
fillin "yes"
