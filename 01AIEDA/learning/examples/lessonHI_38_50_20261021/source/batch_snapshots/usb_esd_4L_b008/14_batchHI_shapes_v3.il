
procedure(hiBindExistingShape(f id net layer)
 let((boundaries b)
  boundaries=nil
  foreach(s axlDBGetShapes(strcat("ETCH/" layer))
   when(s->net && equal(s->net->name net) && s->shapeBoundary
    b=s->shapeBoundary
    unless(member(b boundaries) boundaries=cons(b boundaries))))
  unless(length(boundaries)==1 error("Expected exactly one existing dynamic application shape %s %s found=%L\n" net layer boundaries))
  b=car(boundaries)
  fprintf(f "HI_BIND_EXISTING_SHAPE id=%L net=%L layer=%L boundary=%L\n" id net layer b->??)
  hiReg(id "shape" b)
  b))
procedure(hiVoid(f shapeId points)
 let((row shape opened void ret)
  row=assoc(shapeId hiRegistry)
  unless(row error("Void requires known shape id %s\n" shapeId))
  shape=caddr(row)
  opened=axlDBOpenShape(shape)
  unless(opened error("Cannot open shape for permanent void\n"))
  void=axlDBCreateVoid(opened hiClosedPath(points))
  unless(void error("Cannot create permanent void\n"))
  ret=axlDBCreateCloseShape(opened t)
  unless(ret error("Cannot close shape after permanent void\n"))
  hiRegistry=remove(row hiRegistry)
  hiReg(shapeId "shape" car(ret))
  fprintf(f "HI_PERMANENT_VOID shapeId=%L polygon=%L void=%L actual=%L\n" shapeId points void->?? car(ret)->??)
  t))
procedure(hiHSEIsolationChallenge(out anchorXY localLayer guardPoints)
 let((f mark via beforeCount graph quietShape guard)
  f=outfile(strcat(out "/hi_hse_isolation_challenge.txt"))
  axlShapeDynamicUpdate(nil t) axlDBRefreshId(nil)
  axlDRCUpdate(t) axlDBRefreshId(nil)
  beforeCount=length(axlDBGetDesign()->drcs)
  hiProof(f "C22.2" "C23.2" t)
  hiProof(f "C22.2" "U1.47" t)
  hiProof(f "C22.2" "Y1.2" t)
  mark=axlDBTransactionStart()
  unless(mark error("Cannot start HSE isolation negative-test transaction\n"))
  via=hiResolvePoint("GND" "TOP" anchorXY "via")
  fprintf(f "HSE_NEGATIVE_DELETE_ONLY_ANCHOR=%L\n" via->??)
  unless(axlDeleteObject(via) error("Cannot delete single HSE bridge via\n"))
  axlShapeDynamicUpdate(nil t) axlDBRefreshId(nil)
  hiProof(f "C22.2" "C23.2" t)
  graph=gConnectedObjects(gPin("C22" "2"))
  quietShape=setof(s graph equal(s->objType "shape") && equal(s->layer strcat("ETCH/" localLayer)) && s->fill)
  unless(quietShape error("Local island disconnected in anchor-negative test\n"))
  foreach(guardXY guardPoints
   guard=hiResolvePoint("GND" "TOP" guardXY "point")
   fprintf(f "NEGATIVE_LOCAL_REFERENCE count=%d guardXY=%L guardReached=%L\n" length(quietShape) guardXY if(member(guard graph) then t else nil))
   unless(member(guard graph) error("Quiet guard disconnected in anchor-negative test\n")))
  hiProof(f "C22.2" "U1.47" nil)
  hiProof(f "C22.2" "Y1.2" nil)
  hiProof(f "C15.2" "U1.47" t)
  hiProof(f "Y1.2" "Y1.4" t)
  hiProof(f "Y1.2" "U1.47" t)
  fprintf(f "HSE_NEGATIVE_ACTUAL_GND_NET_UNCONNECTED=%L\n" axlDBFindByName('net "GND")->unconnected)
  unless(axlDBTransactionRollback(mark) error("Cannot rollback HSE anchor deletion\n"))
  axlShapeDynamicUpdate(nil t) axlDBRefreshId(nil)
  hiProof(f "C22.2" "C23.2" t)
  hiProof(f "C22.2" "U1.47" t)
  hiProof(f "C22.2" "Y1.2" t)
  axlDRCUpdate(t) f29DumpDRC(f "HSE_ANCHOR_RESTORED")
  unless(length(axlDBGetDesign()->drcs)==beforeCount error("Restored HSE DRC count differs\n"))
  fprintf(f "HSE_ISOLATION_NEGATIVE_TEST_COMPLETE_NO_SAVE\n") close(f) t))

procedure(hiAssignNetClass(f name domain cset nets)
 let((nc net old prop)
  nc=axlNetClassCreate(name domain)
  unless(nc error("Cannot create scoped netclass %s\n" name))
  prop=if(equal(domain 'physical) then "PHYSICAL_CONSTRAINT_SET" else "SPACING_CONSTRAINT_SET")
  unless(axlDBAddProp(list(nc) list(list(prop cset))) error("Cannot assign scoped class CSet\n"))
  foreach(n nets
   net=axlDBFindByName('net n)
   unless(net error("Missing logical net while assigning class\n"))
   old=axlNetClassGet(net domain t)
   when(old unless(axlNetClassRemove(old net) error("Cannot remove old domain class member\n")))
   unless(axlNetClassAdd(nc net) error("Cannot add scoped class member\n"))
   fprintf(f "HI_CLASS_REASSIGN net=%L domain=%L old=%L new=%L baseCSet=%L directNetProperties=%L\n" n domain if(old then old->name else nil) name cset axlDBGetProperties(net)))
  axlCNSMapUpdate()
  t))

procedure(hiBindExistingStaticShape(f id net layer)
 let((shapes)
  shapes=setof(s axlDBGetShapes(strcat("ETCH/" layer)) s->net && equal(s->net->name net) && !s->shapeBoundary && !s->shapeIsBoundary && s->fill)
  unless(length(shapes)==1 error("Expected one actual static reference shape %s/%s found=%L\n" net layer shapes))
  fprintf(f "HI_BIND_STATIC_SHAPE id=%L layer=%L shape=%L\n" id layer car(shapes)->??)
  hiReg(id "shape" car(shapes))
  car(shapes)))
procedure(hiShapeBoundaryRead(out)
 let((f poly holes)
  f=outfile(strcat(out "/hi_dynamic_boundaries.tsv"))
  fprintf(f "layer\tnet\tbbox\tvertices\tpermanentVoids\tattributes\n")
  foreach(s axlDBGetShapes("BOUNDARY")
   poly=car(axlPolyFromDB(s)) holes=nil
   foreach(v s->voids
    foreach(p axlPolyFromDB(v) holes=append(holes list(p->vertices))))
   fprintf(f "%L\t%L\t%L\t%L\t%L\t%L\n" s->layer if(s->net then s->net->name else nil) s->bBox if(poly then poly->vertices else nil) holes s->??))
  fprintf(f "HI_DYNAMIC_BOUNDARY_READ_COMPLETE\n") close(f) t))

procedure(hiShape(f id net layer points dynamic voids)
 let((shape ret boundary geometry)
  geometry=if(equal(points "ROUTE_KEEPIN") then car(axlPolyFromDB(axlDBGetDesign()->keepinRoute)) else hiClosedPath(points))
  unless(geometry error("No valid shape outline geometry\n"))
  shape=axlDBCreateOpenShape(geometry t strcat("ETCH/" layer) net)
  unless(shape error("Cannot create actual open ETCH shape\n"))
  foreach(v voids
   unless(axlDBCreateVoid(shape hiClosedPath(v)) error("Cannot create permanent void before shape close\n")))
  ret=axlDBCreateCloseShape(shape t)
  unless(ret error("Cannot close actual ETCH shape with requested voids\n"))
  shape=car(ret)
  when(dynamic
   boundary=axlShapeChangeDynamicType(shape t t)
   unless(boundary error("Cannot convert reference shape to dynamic\n"))
   shape=boundary
   unless(equal(axlShapeDynamicUpdate(shape t) 0) error("Reference shape update failed\n")))
  fprintf(f "HI_SHAPE id=%L net=%L layer=%L dynamic=%L requestedVoidCount=%d object=%L\n" id net layer dynamic length(voids) shape->??)
  hiReg(id "shape" shape)
  shape))

procedure(hiCSetLayerValue(f domain name layer key value)
 let((ret actual)
  if(equal(domain 'physical) then
   ret=axlCNSSetPhysical(name layer key value)
   actual=axlCNSGetPhysical(name layer key)
  else
   ret=axlCNSSetSpacing(name layer key value)
   actual=axlCNSGetSpacing(name layer key))
  unless(ret error("Cannot set layer-specific CSet field\n"))
  fprintf(f "HI_CSET_LAYER_VALUE domain=%L cset=%L layer=%L key=%L requested=%L actual=%L\n" domain name layer key value actual)
  t))
procedure(hiRegion(f id layer polygon assignments)
 let((region shape tbl)
  region=axlRegionCreate(id)
  unless(region error("Cannot create region %s\n" id))
  shape=car(axlDBCreateShape(hiClosedPath(polygon) nil strcat("CONSTRAINT REGION/" layer)))
  unless(shape && axlRegionAdd(region shape) error("Cannot create actual region polygon\n"))
  foreach(a assignments
   tbl=axlCnsClassTableCreate(car(a) nth(3 a) region cadr(a) caddr(a))
   unless(tbl error("Cannot assign Region-Class or Region-Class-Class rule\n"))
   fprintf(f "HI_REGION_CLASS region=%L class1=%L class2=%L domain=%L cset=%L table=%L\n" id car(a) nth(3 a) cadr(a) caddr(a) tbl->??))
  fprintf(f "HI_REGION_GEOMETRY %L\n" shape->??)
  axlCNSMapUpdate()
  t))

procedure(hiDeleteSegment(f id net layer points width)
 let((matches seen obj old countBefore countAfter)
  matches=nil seen=nil
  foreach(obj axlExtractMap("C:/Program0/Cadence/SPB172/share/pcb/text/views/fgeo_bv.txt" nil)
   unless(member(obj seen)
    seen=cons(obj seen)
    when(equal(obj->objType "line") && obj->isEtch && obj->net && equal(obj->net->name net) && equal(obj->layer strcat("ETCH/" layer)) && abs(obj->width-width)<0.00001 &&
      (equal(obj->startEnd points) || equal(reverse(obj->startEnd) points))
     matches=cons(obj matches))))
  unless(length(matches)==1 error("Exact old cline segment not uniquely found for controlled ripup %s found=%L\n" id matches))
  old=car(matches)
  fprintf(f "HI_DELETE_EXACT_SEGMENT id=%L before=%L parentType=%L thermal=%L\n" id old->?? old->parent->objType old->thermal)
  when(old->thermal error("Refuse explicit manual-ripup operation on generated thermal relief\n"))
  unless(axlDeleteObject(old) error("Cannot delete exact selected cline segment\n"))
  axlDBRefreshId(nil)
  fprintf(f "HI_DELETE_EXACT_SEGMENT_COMPLETE id=%L net=%L layer=%L points=%L width=%L\n" id net layer points width)
  t))
procedure(hiRouteRoles(out)
 let((f seen p g count thermalCount)
  f=outfile(strcat(out "/hi_route_roles.tsv"))
  fprintf(f "net\tlayer\tstartEnd\twidth\tisEtch\tthermal\tparentType\tparentAttributes\tgrandparentType\n")
  seen=nil count=0 thermalCount=0
  foreach(o axlExtractMap("C:/Program0/Cadence/SPB172/share/pcb/text/views/fgeo_bv.txt" nil)
   unless(member(o seen)
    seen=cons(o seen)
    when(equal(o->objType "line") && o->layer && rexMatchp("^ETCH/" o->layer)
     p=o->parent g=if(p then p->parent else nil)
     count=count+1
     when(o->thermal thermalCount=thermalCount+1)
     fprintf(f "%L\t%L\t%L\t%L\t%L\t%L\t%L\t%L\t%L\n" if(o->net then o->net->name else nil) o->layer o->startEnd o->width o->isEtch o->thermal if(p then p->objType else nil) if(p then p->?? else nil) if(g then g->objType else nil)))))
  close(f)
  f=outfile(strcat(out "/hi_route_roles_summary.txt"))
  fprintf(f "actualEtchLines=%d\nthermalReliefLines=%d\nHI_ROUTE_ROLES_COMPLETE\n" count thermalCount)
  close(f) t))

procedure(hiECSetCopy(f name copy values pairName)
 let((ec pair)
  ec=axlCNSEcsetCreate(name copy)
  unless(ec error("Cannot copy electrical CSet template\n"))
  foreach(v values
   unless(axlCNSEcsetValueSet(name car(v) cadr(v)) error("Cannot set scoped electrical CSet field\n"))
   fprintf(f "HI_ECSET_VALUE name=%L key=%L requested=%L actual=%L\n" name car(v) cadr(v) axlCNSEcsetValueGet(name car(v))))
  pair=car(setof(p axlDBGetDesign()->diffpair equal(p->name pairName)))
  unless(pair error("Differential pair target not found\n"))
  unless(axlDBAddProp(list(pair) list(list("ELECTRICAL_CONSTRAINT_SET" name))) error("Cannot assign pair-specific electrical CSet\n"))
  axlCNSMapUpdate()
  fprintf(f "HI_PAIR_ECSET_COPY pair=%L sourceTemplate=%L newCSet=%L properties=%L pairAttributes=%L\n" pairName copy name axlDBGetProperties(pair) pair->??)
  t))
