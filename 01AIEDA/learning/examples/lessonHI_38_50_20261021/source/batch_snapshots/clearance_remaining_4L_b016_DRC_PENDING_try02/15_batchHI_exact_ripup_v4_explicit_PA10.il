hiRipupNormalizationActive=nil
hiRipupAllowedObjects=nil
procedure(hiPrepareExplicitPA10TransientWhitelist(f)
 let((o original other desc)
  hiRipupAllowedObjects=nil
  foreach(pp list(list(list(40.0 20.3) list(40.0 20.5)) list(list(40.0 20.3) list(48.4 20.3)) list(list(48.4 20.3) list(50.1 22.0)) list(list(50.1 22.0) list(50.1 22.4)))
   o=car(hiFindExactManualLine("PA10_UART_RX" "BOTTOM" pp 0.2))
   unless(o error("Explicit PA10 transitional whitelist baseline line absent\n"))
   original=hiManualLineSignature(o) other=sprintf(nil "%L" list("GND" "ETCH/BOTTOM" pp 0.2)) desc=list("line" pp 0.2)
   hiRipupAllowedObjects=cons(list(o original other desc) hiRipupAllowedObjects))
  foreach(x list(list(list(40.0 20.5) "HI_VIA026_C052_TENT") list(list(50.1 22.4) "L28_VIA030_C060"))
   o=hiUniqueVia("PA10_UART_RX" car(x) cadr(x)) original=sprintf(nil "%L" hiViaIdentity(o)) other=sprintf(nil "%L" list(car(x) cadr(x) "GND")) desc=list("via" car(x) cadr(x))
   hiRipupAllowedObjects=cons(list(o original other desc) hiRipupAllowedObjects))
  fprintf(f "HI_EXPLICIT_TRANSIENT_WHITELIST_PREBOUND_ONLY_SIX=%L\n" hiRipupAllowedObjects) drain(f) t))
procedure(hiNormalizeExactRipupSignature(o sig)
 let((row)
  row=assoc(o hiRipupAllowedObjects)
  if(hiRipupNormalizationActive && row && equal(sig caddr(row)) then
   fprintf(hiRipupAuditF "HI_EXPLICIT_TRANSIENT_RELABEL_SAME_ORIGINAL_DBID object=%L before=%s after=%s geometryLayerWidthIdentityExact=t\n" o cadr(row) sig)
   cadr(row)
  else sig)))
procedure(hiVerifyExplicitPA10Restored(f)
 let((d now)
  foreach(row hiRipupAllowedObjects
   d=nth(3 row)
   now=if(equal(car(d) "line") then car(hiFindExactManualLine("PA10_UART_RX" "BOTTOM" cadr(d) caddr(d))) else hiUniqueVia("PA10_UART_RX" cadr(d) caddr(d)))
   unless(now error("Original PA10 bridge object not restored to exact original net+geometry\n"))
   fprintf(f "HI_EXPLICIT_TRANSIENT_FINAL_RESTORED originalObject=%L actualObject=%L originalDescriptor=%L originalNetPA10=t\n" car(row) now d))
  fprintf(f "HI_EXPLICIT_TRANSIENT_SIX_OBJECTS_RESTORED_COUNT=%d\n" length(hiRipupAllowedObjects)) t))
procedure(hiFindExactManualLine(net layer points width)
 let((matches seen obj)
  matches=nil seen=nil
  foreach(obj axlExtractMap("C:/Program0/Cadence/SPB172/share/pcb/text/views/fgeo_bv.txt" nil)
   unless(member(obj seen)
    seen=cons(obj seen)
    when(equal(obj->objType "line") && obj->isEtch && obj->net && equal(obj->net->name net) && equal(obj->layer strcat("ETCH/" layer)) && abs(obj->width-width)<0.00001 && (equal(obj->startEnd points) || equal(reverse(obj->startEnd) points))
     matches=cons(obj matches))))
  matches))
procedure(hiManualLineSignature(o)
 let((pp)
  pp=o->startEnd
  when(caar(pp)>caadr(pp) || (equal(caar(pp) caadr(pp)) && cadar(pp)>cadadr(pp)) pp=reverse(pp))
  hiNormalizeExactRipupSignature(o sprintf(nil "%L" list(if(o->net then o->net->name else nil) o->layer pp o->width)))))
procedure(hiExactRipupInventory(exclude)
 let((seen lines vias)
  seen=nil lines=nil vias=nil
  foreach(o axlExtractMap("C:/Program0/Cadence/SPB172/share/pcb/text/views/fgeo_bv.txt" nil)
   unless(member(o seen)
    seen=cons(o seen)
    unless(member(o exclude)
     when(equal(o->objType "line") && o->isEtch && !o->thermal && !(o->parent && o->parent->thermal)
      lines=cons(hiManualLineSignature(o) lines))
     when(equal(o->objType "via") vias=cons(hiNormalizeExactRipupSignature(o sprintf(nil "%L" hiViaIdentity(o))) vias)))))
  list(sort(lines 'alphalessp) sort(vias 'alphalessp))))
procedure(hiDeleteExactBatch(f specs)
 let((objects seen targets matches selected before expected after mark complete type id net layer geom value)
  fprintf(f "HI_EXACT_RIPUP_ENTER\n") drain(f)
  objects=axlExtractMap("C:/Program0/Cadence/SPB172/share/pcb/text/views/fgeo_bv.txt" nil)
  fprintf(f "HI_EXACT_RIPUP_EXTRACTED_COUNT=%d\n" length(objects)) drain(f)
  seen=nil targets=nil complete=nil
  foreach(spec specs
   type=car(spec) id=cadr(spec) net=caddr(spec) layer=nth(3 spec) geom=nth(4 spec) value=nth(5 spec)
   fprintf(f "HI_EXACT_RIPUP_MATCHING_ID=%L\n" id) drain(f)
   matches=nil seen=nil
   if(equal(type "deleteVia") then matches=list(hiUniqueVia(net geom value)) else matches=hiFindExactManualLine(net layer geom value))
   unless(length(matches)==1 error("Controlled batch ripup prebinding requires unique original net+geometry for %s found=%L\n" id matches))
   selected=car(matches)
   when(member(selected targets) error("Duplicate selection in controlled exact batch ripup %s\n" id))
   when(equal(type "deleteSegment") && (selected->thermal || (selected->parent && selected->parent->thermal)) error("Refuse thermal-relief target\n"))
   fprintf(f "HI_EXACT_RIPUP_PREBOUND id=%L type=%L originalNet=%L object=%L originalDescriptor=%L\n" id type net selected spec)
   drain(f) targets=cons(selected targets))
  hiPrepareExplicitPA10TransientWhitelist(f) hiRipupAuditF=f
  before=hiExactRipupInventory(nil)
  expected=hiExactRipupInventory(targets)
  fprintf(f "HI_EXACT_RIPUP_BATCH_START targets=%d manualLinesBefore=%d viasBefore=%d expectedOtherManualLines=%d expectedOtherVias=%d\n" length(targets) length(car(before)) length(cadr(before)) length(car(expected)) length(cadr(expected)))
  drain(f) mark=axlDBTransactionStart()
  unless(mark error("Cannot start exact-ripup transaction\n"))
  unwindProtect(
   progn(
    unless(axlDeleteObject(targets) error("Official atomic list deletion failed\n"))
    axlDBRefreshId(nil)
    fprintf(f "HI_EXACT_NATIVE_LIST_DELETE_RETURNED\n") drain(f)
    fprintf(f "HI_EXACT_NATIVE_LIST_DELETE_RETURNED\n") drain(f)
    fprintf(f "HI_EXACT_NATIVE_LIST_DELETE_RETURNED\n") drain(f)
    hiRipupNormalizationActive=t
    after=hiExactRipupInventory(nil)
    hiRipupNormalizationActive=nil
    fprintf(f "HI_EXACT_RIPUP_BATCH_ACTUAL remainingManualLines=%d remainingVias=%d nonTargetManualLineGeometryNetWidthPreserved=%L nonTargetViaIdentityPreserved=%L\n" length(car(after)) length(cadr(after)) equal(car(expected) car(after)) equal(cadr(expected) cadr(after)))
    foreach(sig car(expected) unless(member(sig car(after)) fprintf(f "HI_NON_TARGET_LINE_SIGNATURE_BEFORE_ONLY=%s\n" sig)))
    foreach(sig car(after) unless(member(sig car(expected)) fprintf(f "HI_NON_TARGET_LINE_SIGNATURE_AFTER_ONLY=%s\n" sig)))
    foreach(sig cadr(expected) unless(member(sig cadr(after)) fprintf(f "HI_NON_TARGET_VIA_SIGNATURE_BEFORE_ONLY=%s\n" sig)))
    foreach(sig cadr(after) unless(member(sig cadr(expected)) fprintf(f "HI_NON_TARGET_VIA_SIGNATURE_AFTER_ONLY=%s\n" sig)))
    drain(f)
    unless(equal(expected after) error("Exact-ripup changed non-target manual copper/via identities; rollback required\n"))
    unless(axlDBTransactionCommit(mark) error("Cannot commit exact-ripup transaction\n"))
    complete=t)
   progn(hiRipupNormalizationActive=nil
   unless(complete
    axlDBTransactionRollback(mark) axlDBRefreshId(nil)
    fprintf(f "HI_EXACT_RIPUP_BATCH_FAILED_ROLLBACK=%L\n" equal(before hiExactRipupInventory(nil))))))
  fprintf(f "HI_EXACT_RIPUP_BATCH_COMPLETE_NO_NON_TARGET_CHANGE targetCount=%d\n" length(targets))
  t))
