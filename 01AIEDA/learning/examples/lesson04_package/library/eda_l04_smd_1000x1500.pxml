<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE padstack>
<padstack version="1.0">
  <padstackname>eda_l04_smd_1000x1500</padstackname>
  <padstackusage>SMD_PIN</padstackusage>
  <units>Mm</units>
  <accuracy>3</accuracy>
  <drillinfo><slothole><holetype>NONE</holetype></slothole></drillinfo>
  <pad>
    <type>REGULAR_PAD</type><layer>BEGIN_LAYER</layer><figure>RECTANGLE</figure>
    <offset>(0;0)</offset><width>1.000</width><height>1.500</height>
  </pad>
  <pad>
    <type>REGULAR_PAD</type><layer>TOP_SOLDER_MASK_PAD</layer><figure>RECTANGLE</figure>
    <offset>(0;0)</offset><width>1.100</width><height>1.600</height>
  </pad>
  <pad>
    <type>REGULAR_PAD</type><layer>TOP_PASTE_MASK_PAD</layer><figure>RECTANGLE</figure>
    <offset>(0;0)</offset><width>0.900</width><height>1.400</height>
  </pad>
</padstack>
