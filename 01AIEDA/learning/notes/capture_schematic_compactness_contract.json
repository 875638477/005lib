  "allowed_budget_reasons": ["approved_native_reference", "full_text_and_symbol_clearance", "shared_longest_required_text", "native_hotspot_alignment", "functional_branch_preservation", "user_locked_scope"],
  "forbidden_budget_reason": "whole_page_column_or_canvas_fill",
  "unknown_is_pass": false,
  "objective": "Appropriately short within readable local circuit constraints, not mechanical global shortest",
  "checker_scope": "Read-only bound facts and independently verified reasonable candidate budgets; no CAD edits or candidate solver"
