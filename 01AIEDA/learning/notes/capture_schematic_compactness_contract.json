{
  "version": "COMPACT-20261116.1",
  "authority": "capture_schematic_compactness_standard.md",
  "scope": "Inventoried local functional groups and actual component-to-terminal paths within the requested schematic scope",
  "mandatory_with": ["RC-20261116.2 five checks", "current endpoint/topology requirements", "native electrical validation"],
  "required_checks": ["COMPACTGRID", "COMPACTFUNCTION", "COMPACTCLEAR", "COMPACTPITCH", "COMPACTLEADS"],
  "default_slack_grids": 1,
