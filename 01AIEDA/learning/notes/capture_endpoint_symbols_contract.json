  "forbidden_pass_shortcuts": [
    "color",
    "fixed_rotation_or_mirror_only",
    "coordinates_on_grid_only",
    "Alias_anchor_on_wire_only",
    "RC_checker_pass_only",
    "PST_equality_only",
    "collision_count_zero_without_expected_relationships",
    "renderer_unresolved_zero",
    "screenshot_without_native_profile",
    "estimated_true_facts_without_source_bound_evidence"
  ],
  "release_rule": "Every inventoried endpoint and applicable check needs bound evidence. Missing/uncalibrated/unsupported means unknown; conflict means fail. No endpoint/full-page completion claim with fail or unknown. Electrical, offline model, GUI and PCB conclusions remain separate."
