version 17.2

setwindow pcb
trapsize 7521
placementedit
pdf out 
setwindow form.pdf_out
FORM pdf_out pdftree 'MULTISEL YES' PDFTOP 
FORM pdf_out pdftree  PDFTOP 
FORM pdf_out pdftree 'MULTISEL YES' PDFBOTTOM 
FORM pdf_out pdftree  PDFBOTTOM 
FORM pdf_out export  
FORM pdf_out cancel  
setwindow pcb
placementedit 

